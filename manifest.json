{
  "manifest_version": 3,
  "name": "KeepShelf",
  "version": "1.0.0",
  "description": "Save movies, series, anime, and books to your shelf. Sync to Google Keep.",
  "permissions": ["storage", "tabs", "scripting", "debugger"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.imdb.com/*",
    "https://seriesgraph.com/*",
    "https://keep.google.com/*",
    "https://www.goodreads.com/*",
    "https://www.book-filter.com/*",
    "https://myanimelist.net/*"
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seriesgraph.com/show/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.imdb.com/title/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.goodreads.com/book/show/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.book-filter.com/books/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://myanimelist.net/anime/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
